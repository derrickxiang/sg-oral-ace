rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'planTier',
          'trialSessionsRemaining',
          'weeklyStreak',
          'totalSessionsCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'planTier',
          'trialSessionsRemaining',
          'weeklyStreak',
          'totalSessionsCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.planTier is string && data.planTier.size() <= 32 &&
        (data.planTier == 'trial' || data.planTier == 'monthly_pro' || data.planTier == 'annual_pro' || data.planTier == 'school_pass') &&
        data.trialSessionsRemaining is int && data.trialSessionsRemaining >= 0 && data.trialSessionsRemaining <= 100 &&
        data.weeklyStreak is int && data.weeklyStreak >= 0 && data.weeklyStreak <= 10000 &&
        data.totalSessionsCompleted is int && data.totalSessionsCompleted >= 0 && data.totalSessionsCompleted <= 100000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'activePlanName', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'activePlanName', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.activePlanName is string && data.activePlanName.size() >= 1 && data.activePlanName.size() <= 100 &&
        data.updatedAt is timestamp;
    }

    function isValidPracticeRecord(data) {
      return data.keys().hasAll([
          'userId',
          'topicId',
          'topicTitle',
          'totalScore',
          'band',
          'initialTranscript',
          'followUpQuestion',
          'followUpTranscript',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'topicId',
          'topicTitle',
          'totalScore',
          'band',
          'initialTranscript',
          'followUpQuestion',
          'followUpTranscript',
          'createdAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 100 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 200 &&
        data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 50 &&
        data.band is string && data.band.size() <= 1 && data.band.size() <= 64 &&
        data.initialTranscript is string && data.initialTranscript.size() >= 1 && data.initialTranscript.size() <= 5000 &&
        data.followUpQuestion is string && data.followUpQuestion.size() <= 2000 &&
        data.followUpTranscript is string && data.followUpTranscript.size() <= 5000 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidUserProfile(incoming()) && isOwner(userId) && isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['planTier', 'trialSessionsRemaining', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['trialSessionsRemaining', 'weeklyStreak', 'totalSessionsCompleted', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidUserPrivateInfo(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['activePlanName', 'email', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }

      match /practices/{practiceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(practiceId) &&
          existing().userId == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(practiceId) &&
          isValidPracticeRecord(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(practiceId) &&
          existing().userId == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
